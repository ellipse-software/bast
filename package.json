{
  "name": "bast",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web",
    "apps/web/vendor/typescript"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run build:bast && bun run build:web",
    "build:bast": "go -C apps/bast build -trimpath -o bast .",
    "build:web": "bun run --cwd apps/web build",
    "lint": "bun run lint:web",
    "lint:web": "bun run --cwd apps/web lint",
    "test": "go -C apps/bast test ./...",
    "sync:skill": "bash scripts/sync-skill.sh",
    "changelog:extract": "bash .github/scripts/changelog.sh extract",
    "changelog:preview": "bash .github/scripts/changelog.sh preview",
    "changelog:cut": "bash .github/scripts/changelog.sh cut",
    "check": "bun run sync:skill && go -C apps/bast mod verify && go -C apps/bast test ./... && go -C apps/bast vet ./... && bun run lint:web && bun run build:web"
  }
}
