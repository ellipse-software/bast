#!/bin/sh

set -eu

repo="ellipse-software/bast"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  bold=$(printf '\033[1m')
  dim=$(printf '\033[2m')
  green=$(printf '\033[32m')
  cyan=$(printf '\033[36m')
  yellow=$(printf '\033[33m')
  red=$(printf '\033[31m')
  purple=$(printf '\033[1;35m')
  purple_bright=$(printf '\033[1;95m')
  reset=$(printf '\033[0m')
else
  bold=''
  dim=''
  green=''
  cyan=''
  yellow=''
  red=''
  purple=''
  purple_bright=''
  reset=''
fi

blank() {
  printf '\n'
}

print_banner() {
  blank
  printf '  %s%s%s\n' "$purple" '██████╗  █████╗ ███████╗████████╗' "$reset"
  printf '  %s%s%s\n' "$purple" '██╔══██╗██╔══██╗██╔════╝╚══██╔══╝' "$reset"
  printf '  %s%s%s\n' "$purple" '██████╔╝███████║███████╗   ██║   ' "$reset"
  printf '  %s%s%s\n' "$purple" '██╔══██╗██╔══██║╚════██║   ██║   ' "$reset"
  printf '  %s%s%s\n' "$purple" '██████╔╝██║  ██║███████║   ██║   ' "$reset"
  printf '  %s%s%s\n' "$purple" '╚═════╝ ╚═╝  ╚═╝╚══════╝   ╚═╝   ' "$reset"
  blank
}

info() {
  printf '  %s%s%s\n' "$dim" "$1" "$reset"
}

step() {
  printf '  %s→%s %s\n' "$cyan" "$reset" "$1"
}

success() {
  printf '  %s✓%s %s\n' "$green" "$reset" "$1"
}

note() {
  printf '  %s%s%s\n' "$yellow" "$1" "$reset"
}

print_telemetry_notice() {
  info "Bast collects basic anonymous telemetry to help improve the tool."
  printf '  %sOpt out with %sBAST_NO_TELEMETRY=1%s%s.\n' "$dim" "$bold" "$reset" "$dim"
  blank
}

print_run_hint() {
  blank
  printf '  %sRun $ %sbast%s%s to get started.\n' "$dim" "$purple_bright" "$reset" "$dim"
}

send_telemetry() {
  event_name="$1"

  [ -n "${BAST_NO_TELEMETRY:-}" ] && return 0

  payload="$(printf '{"event":"%s","version":"%s","os":"%s","arch":"%s","source":"installer"}' \
    "$event_name" "$version" "$os" "$arch")"

  curl -fsS -X POST \
    -H "Content-Type: application/json" \
    -d "$payload" \
    "https://bast.sh/api/telemetry" >/dev/null 2>&1 || true
}

print_uninstall() {
  blank
  info "To uninstall later:"
  printf '    %srm "%s" "%s"%s\n' "$dim" "$install_path" "$receipt_path" "$reset"
  if [ -n "${completion_dir:-}" ]; then
    printf '    %srm -rf "%s"%s\n' "$dim" "$completion_dir" "$reset"
  fi
  if [ -n "${fish_completion:-}" ]; then
    printf '    %srm -f "%s"%s\n' "$dim" "$fish_completion" "$reset"
  fi
}

write_completion_script() {
  shell="$1"
  dest="$2"
  if "$install_path" completion "$shell" >"$dest.tmp" 2>/dev/null && [ -s "$dest.tmp" ]; then
    mv "$dest.tmp" "$dest"
    return 0
  fi
  rm -f "$dest.tmp"
  return 1
}

upsert_rc_block() {
  target="$1"
  body="$2"
  begin='# >>> bast completions >>>'
  end='# <<< bast completions <<<'
  mkdir -p "$(dirname "$target")"
  stripped="$temp_dir/rc-stripped"
  if [ -f "$target" ]; then
    awk -v begin="$begin" -v end="$end" '
      $0 == begin { skip=1; next }
      skip == 1 && $0 == end { skip=0; next }
      skip == 1 { next }
      { print }
    ' "$target" >"$stripped"
  else
    : >"$stripped"
  fi
  trimmed="$temp_dir/rc-trimmed"
  awk 'BEGIN { n=0 } { lines[++n]=$0 } END { while (n>0 && lines[n]=="") n--; for (i=1;i<=n;i++) print lines[i] }' "$stripped" >"$trimmed"
  {
    if [ -s "$trimmed" ]; then
      cat "$trimmed"
      printf '\n'
    fi
    printf '%s\n%s\n%s\n' "$begin" "$body" "$end"
  } >"$target"
}

install_shell_completions() {
  [ -n "${HOME:-}" ] || return 0
  [ -z "${BAST_NO_COMPLETIONS:-}" ] || return 0
  [ -x "$install_path" ] || return 0
  [ -n "${completion_dir:-}" ] || return 0

  mkdir -p "$completion_dir"
  if ! write_completion_script bash "$completion_dir/bast.bash"; then
    return 0
  fi

  step "Enabling shell completions..."
  write_completion_script zsh "$completion_dir/_bast" || true
  write_completion_script fish "$completion_dir/bast.fish" || true
  write_completion_script powershell "$completion_dir/bast.ps1" || true
  write_completion_script elvish "$completion_dir/bast.elv" || true
  write_completion_script nushell "$completion_dir/bast.nu" || true

  mkdir -p "$(dirname "$bash_completion_file")"
  install -m 0644 "$completion_dir/bast.bash" "$bash_completion_file"

  login_shell="${SHELL##*/}"
  if [ -f "$completion_dir/bast.fish" ] && { [ "$login_shell" = "fish" ] || command -v fish >/dev/null 2>&1 || [ -d "$config_home/fish" ]; }; then
    mkdir -p "$(dirname "$fish_completion")"
    install -m 0644 "$completion_dir/bast.fish" "$fish_completion"
  fi

  if [ -f "$completion_dir/_bast" ] && { [ "$login_shell" = "zsh" ] || [ -f "$HOME/.zshrc" ]; }; then
    upsert_rc_block "$HOME/.zshrc" "if typeset -f compdef >/dev/null 2>&1; then
  . \"$completion_dir/_bast\"
fi"
  fi

  if [ -f "$completion_dir/bast.bash" ] && { [ "$login_shell" = "bash" ] || [ -f "$HOME/.bashrc" ] || [ -f "$HOME/.bash_profile" ]; }; then
    bash_block=". \"$completion_dir/bast.bash\""
    if [ -f "$HOME/.bashrc" ] || [ "$login_shell" = "bash" ]; then
      upsert_rc_block "$HOME/.bashrc" "$bash_block"
    fi
    if [ -f "$HOME/.bash_profile" ]; then
      upsert_rc_block "$HOME/.bash_profile" "$bash_block"
    fi
  fi

  pwsh_profile="$config_home/powershell/Microsoft.PowerShell_profile.ps1"
  if [ -f "$completion_dir/bast.ps1" ] && { command -v pwsh >/dev/null 2>&1 || [ -f "$pwsh_profile" ]; }; then
    upsert_rc_block "$pwsh_profile" "if (Test-Path -LiteralPath '$completion_dir/bast.ps1') {
  . '$completion_dir/bast.ps1'
}"
  fi

  elvish_rc="$config_home/elvish/rc.elv"
  if [ -f "$completion_dir/bast.elv" ] && { command -v elvish >/dev/null 2>&1 || [ -f "$elvish_rc" ]; }; then
    upsert_rc_block "$elvish_rc" "eval (slurp < '$completion_dir/bast.elv')"
  fi

  nushell_config="$config_home/nushell/config.nu"
  if [ -f "$completion_dir/bast.nu" ] && { command -v nu >/dev/null 2>&1 || [ -f "$nushell_config" ]; }; then
    upsert_rc_block "$nushell_config" "source \"$completion_dir/bast.nu\""
  fi

  success "Enabled shell completions"
  info "Open a new terminal, then press Tab after bast."
}

remove_script_install() {
  if [ -e "$install_path" ] || [ -e "$receipt_path" ]; then
    step "Removing existing Bast at ${install_path}..."
    rm -f "$install_path" "$receipt_path"
    success "Removed previous install"
  fi
}

prepare_channel_switch() {
  other_channel=0

  if [ -f "$receipt_path" ]; then
    installed_receipt="$(tr -d '\r\n' < "$receipt_path")"
    if [ "$installed_receipt" = "https://bast.sh/install-nightly" ]; then
      other_channel=1
    fi
  fi

  if [ "$other_channel" -eq 0 ] && [ -x "$install_path" ]; then
    installed_output="$("$install_path" --version 2>/dev/null || true)"
    case "$installed_output" in
    "bast nightly."*)
      other_channel=1
      ;;
    esac
  fi

  if [ "$other_channel" -eq 1 ]; then
    note "Switching from nightly to stable..."
    remove_script_install
  fi

  if command -v brew >/dev/null 2>&1; then
    if brew list --formula bast-nightly >/dev/null 2>&1; then
      step "Uninstalling Homebrew bast-nightly..."
      brew uninstall bast-nightly >/dev/null
      success "Uninstalled bast-nightly"
    fi
  fi
}

write_receipt() {
  printf '%s\n' 'https://bast.sh/install' > "$temp_dir/install-receipt"
  mkdir -p "$install_dir"
  install -m 0644 "$temp_dir/install-receipt" "$receipt_path"
}

fail() {
  blank
  printf '  %s✗%s %s\n' "$red" "$reset" "$1" >&2
  blank
  exit 1
}

print_banner
print_telemetry_notice

for command_name in curl install mktemp tar; do
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required"
done

case "$(uname -s)" in
Darwin) os="darwin" ;;
Linux) os="linux" ;;
*) fail "macOS and Linux are currently supported" ;;
esac

case "$(uname -m)" in
arm64 | aarch64) arch="arm64" ;;
x86_64 | amd64) arch="amd64" ;;
*) fail "unsupported architecture: $(uname -m)" ;;
esac

info "Platform: ${os}/${arch}"

if [ -n "${BAST_INSTALL_DIR:-}" ]; then
  install_dir="$BAST_INSTALL_DIR"
else
  [ -n "${HOME:-}" ] || fail "HOME is not set; set BAST_INSTALL_DIR instead"
  install_dir="$HOME/.local/bin"
fi
install_path="$install_dir/bast"
receipt_path="$install_path.install-receipt"
if [ -n "${HOME:-}" ]; then
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  completion_dir="$data_home/bast/completions"
  fish_completion="$config_home/fish/completions/bast.fish"
  bash_completion_file="${BASH_COMPLETION_USER_DIR:-$data_home/bash-completion}/completions/bast"
else
  completion_dir=""
  fish_completion=""
  bash_completion_file=""
fi

info "Install location: ${install_path}"
blank

prepare_channel_switch

step "Checking for the latest release..."
latest_url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$repo/releases/latest")"
version="${latest_url##*/}"

case "$version" in
v*) ;;
*) fail "could not find the latest release" ;;
esac

success "Latest release: ${version}"

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/bast.XXXXXX")"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup 0 HUP INT TERM

current_version=""
if [ -x "$install_path" ]; then
  current_output="$("$install_path" --version 2>/dev/null || true)"
  case "$current_output" in
  "bast "*) current_version="${current_output#bast }" ;;
  esac
fi

if [ "$current_version" = "$version" ]; then
  write_receipt
  blank
  success "Bast ${version} is already up to date."
  install_shell_completions
  print_run_hint
  send_telemetry "up_to_date"
  print_uninstall
  blank
  exit 0
fi

bundle="bast_${version#v}_${os}_${arch}"
archive="$bundle.tar.gz"
download_url="https://github.com/$repo/releases/download/$version/$archive"

blank
if [ -n "$current_version" ]; then
  step "Updating Bast from ${current_version} to ${version}..."
else
  step "Installing Bast ${version}..."
fi

step "Downloading ${archive}..."
curl -fsSL "$download_url" -o "$temp_dir/$archive"
curl -fsSL "$download_url.sha256" -o "$temp_dir/$archive.sha256"
success "Download complete"

step "Verifying SHA-256 checksum..."
if command -v shasum >/dev/null 2>&1; then
  (cd "$temp_dir" && shasum -a 256 -c "$archive.sha256") >/dev/null
elif command -v sha256sum >/dev/null 2>&1; then
  (cd "$temp_dir" && sha256sum -c "$archive.sha256") >/dev/null
else
  fail "shasum or sha256sum is required"
fi
success "Checksum verified"

step "Installing to ${install_path}..."
tar -xzf "$temp_dir/$archive" -C "$temp_dir"

mkdir -p "$install_dir"
install -m 0755 "$temp_dir/$bundle/bast" "$install_path"
write_receipt

blank
if [ -n "$current_version" ]; then
  success "Updated Bast to ${version}."
  send_telemetry "update"
else
  success "Installed Bast ${version}."
  send_telemetry "install"
fi

case ":${PATH:-}:" in
*":$install_dir:"*) ;;
*)
  note "Add ${install_dir} to your PATH, then run bast."
  ;;
esac

install_shell_completions
print_run_hint
print_uninstall
blank
