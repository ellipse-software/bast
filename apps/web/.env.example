# PostHog (server-side telemetry forwarding from /api/telemetry)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry-compatible DSN (Better Stack Errors ingest) for /api/errors
SENTRY_DSN=

# Better Stack Uptime API (server-only) for /status
# Create monitors against /api/health, /api/health/docs, /api/health/vault
BETTERSTACK_API_TOKEN=
BETTERSTACK_MONITOR_MARKETING=
BETTERSTACK_MONITOR_DOCS=
BETTERSTACK_MONITOR_VAULT=

# Bast Vault (email OTP + Upstash Redis + Cloudflare R2 + Cloudflare Email)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_FROM=
